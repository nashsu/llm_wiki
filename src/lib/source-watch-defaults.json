{
  "enabled": true,
  "autoIngest": true,
  "persistExtractedMarkdown": false,
  "parsingConcurrency": 2,
  "ingestConcurrency": 1,
  "includeExtensions": [
    "md",
    "mdx",
    "txt",
    "org",
    "pdf",
    "doc",
    "docx",
    "docm",
    "ppt",
    "pps",
    "pot",
    "pptx",
    "pptm",
    "ppsx",
    "ppsm",
    "xls",
    "xlsx",
    "xlsm",
    "xlsb",
    "odt",
    "odp",
    "ods",
    "rtf",
    "html",
    "htm",
    "csv",
    "mp4",
    "webm",
    "mov",
    "avi",
    "mkv",
    "mp3",
    "wav",
    "ogg",
    "flac",
    "m4a",
    "png",
    "jpg",
    "jpeg",
    "gif",
    "webp",
    "svg",
    "bmp",
    "tiff",
    "avif",
    "heic"
  ],
  "excludeExtensions": [
    "tmp",
    "temp",
    "bak",
    "swp",
    "part",
    "partial",
    "crdownload",
    "exe",
    "dll",
    "so",
    "dylib",
    "bin",
    "iso",
    "dmg"
  ],
  "excludeDirs": [
    ".git",
    ".svn",
    ".hg",
    ".obsidian",
    ".idea",
    ".vscode",
    "node_modules",
    ".cache",
    "__pycache__"
  ],
  "excludeGlobs": [
    "~$*",
    ".~lock.*#",
    "*.draft.*",
    "draft-*",
    "*.private.*"
  ],
  "maxFileSizeMb": 100
}
